    "def eval_loss_acc(model, loader, criterion, device):\n",
    "  model.eval()\n",
    "  total_loss, correct = 0.0, 0\n",
    "  with torch.no_grad():\n",
    "    for inputs, labels in loader:\n",
    "      inputs, labels = inputs.to(device), labels.to(device)\n",
    "      outputs = model(inputs)\n",
    "      loss = criterion(outputs, labels)\n",
    "      _, preds = torch.max(outputs, 1)\n",
    "      total_loss += loss.item() * inputs.size(0)\n",
    "      correct += torch.sum(preds == labels.data).item()\n",
    "  n = len(loader.dataset)\n",
    "  return total_loss / n, correct / n\n",
    "\n",
    "\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "optimizer = optim.Adam(model.parameters(), lr=LEARNING_RATE)\n",
    "\n",
    "history = {\n",
    "    'train_loss': [],\n",
    "    'train_acc': [],\n",
    "    'test_loss': [],\n",
    "    'test_acc': [],\n",
    "}\n",
    "start_time = time.time()\n",
    "\n",
    "for epoch in range(EPOCHS):\n",
    "  model.train()\n",
    "  run_loss, run_correct = 0.0, 0\n",
    "\n",
    "  for inputs, labels in dataloaders['train']:\n",
    "    inputs, labels = inputs.to(device), labels.to(device)\n",
    "    optimizer.zero_grad()\n",
    "    outputs = model(inputs)\n",
    "    loss = criterion(outputs, labels)\n",
    "    _, preds = torch.max(outputs, 1)\n",
    "    loss.backward()\n",
    "    optimizer.step()\n",
    "\n",
    "    run_loss += loss.item() * inputs.size(0)\n",
    "    run_correct += torch.sum(preds == labels.data).item()\n",
    "\n",
    "  train_loss = run_loss / len(dataloaders['train'].dataset)\n",
    "  train_acc = run_correct / len(dataloaders['train'].dataset)\n",
    "  test_loss, test_acc = eval_loss_acc(\n",
    "      model, dataloaders['test'], criterion, device\n",
    "  )\n",
    "\n",
    "  history['train_loss'].append(train_loss)\n",
    "  history['train_acc'].append(train_acc)\n",
    "  history['test_loss'].append(test_loss)\n",
    "  history['test_acc'].append(test_acc)\n",
    "\n",
    "  print(\n",
    "      f'Epoch [{epoch+1}/{EPOCHS}] | '\n",
    "      f'Train Loss: {train_loss:.4f}, Train Acc: {train_acc:.4f} | '\n",
    "      f'Test Loss: {test_loss:.4f}, Test Acc: {test_acc:.4f}'\n",
    "  )\n",
    "\n",
    "print(f'Selesai dalam {time.time() - start_time:.1f} detik.')\n",
    "\n",
    "ckpt_dir = os.path.join(nb_dir, 'checkpoints')\n",
    "os.makedirs(ckpt_dir, exist_ok=True)\n",
    "weights_path = os.path.join(ckpt_dir, 'mobilenetv2_fish.pth')\n",
    "torch.save(model.state_dict(), weights_path)\n",
    "print('Bobot tersimpan di:', weights_path)\n",
    "\n",
    "epochs_axis = range(1, EPOCHS + 1)\n",
    "plt.figure(figsize=(8, 6))\n",
    "plt.plot(epochs_axis, history['train_loss'], label='Training')\n",
    "plt.plot(epochs_axis, history['test_loss'], label='Testing')\n",
    "plt.xlabel('Epoch')\n",
    "plt.ylabel('Loss')\n",
    "plt.title('Training vs Testing Loss (MobileNetV2)')\n",
    "plt.legend()\n",
    "plt.grid(True, linestyle='--', alpha=0.4)\n",
    "plt.tight_layout()\n",
    "loss_plot_path = os.path.join(nb_dir, 'training_loss_mobilenetv2.png')\n",
    "plt.savefig(loss_plot_path, dpi=300)\n",
    "plt.show()"
   ]
  }
