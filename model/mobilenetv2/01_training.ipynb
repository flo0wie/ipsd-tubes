    "import os\n",
    "import sys\n",
    "import time\n",
    "import matplotlib.pyplot as plt\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "\n",
    "# Pastikan folder model/mobilenetv2 ada di sys.path saat menjalankan cell\n",
    "nb_dir = os.path.abspath(\n",
    "    'model/mobilenetv2' if os.path.isdir('model/mobilenetv2') else '.'\n",
    ")\n",
    "if nb_dir not in sys.path:\n",
    "  sys.path.insert(0, nb_dir)\n",
    "\n",
    "from mobilenetv2 import get_data_loaders, get_mobilenet_v2, resolve_dataset_dir\n",
    "\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print('Device:', device)\n",
    "\n",
    "DATA_DIR = resolve_dataset_dir()\n",
    "print('Dataset terdeteksi di:', DATA_DIR)\n",
    "\n",
    "BATCH_SIZE = 16\n",
    "IMG_SIZE = 96\n",
    "EPOCHS = 10\n",
    "LEARNING_RATE = 0.001\n",
    "\n",
    "dataloaders, class_names = get_data_loaders(\n",
    "    DATA_DIR, batch_size=BATCH_SIZE, img_size=IMG_SIZE\n",
    ")\n",
    "num_classes = len(class_names)\n",
    "print(f'Jumlah kelas ({num_classes}): {class_names}')\n",
    "\n",
    "model = get_mobilenet_v2(num_classes=num_classes, pretrained=True).to(device)"
   ]
